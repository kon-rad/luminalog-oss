rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user owns their own profile document.
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      // `entitlement` is server-owned (written only by the RevenueCat webhook via
      // the Admin SDK, which bypasses rules — see ADR-0018/Task 1). Clients may
      // read it but must never set or change it, on create OR update.
      //
      // NOTE: `voiceCredits` is intentionally NOT locked here. Although credits
      // are *granted* server-side (ADR-0018), the client still legitimately
      // *deducts* voiceCredits directly during live voice-call metering
      // (ios/LuminaLog/Core/Credits/RevenueCatCreditService.swift deductCredits(),
      // called from VoiceCallViewModel). Locking it would break that write path.
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['entitlement']);
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['entitlement']);

      // Soul Constellation day-centroids hold RAW journal-text embedding vectors.
      // Server-only (Admin SDK bypasses rules). Explicitly denied to clients as
      // defense-in-depth — v2 rules already do not cascade the parent allow to
      // subcollections, but this guards against a future blanket wildcard.
      match /constellationCentroids/{dayIndex} {
        allow read, write: if false;
      }

      // Course quiz attempts (AI Power Users / Kids STEM knowledge checks).
      // Each submit is a new attempt doc. Owner-only — plaintext, educational,
      // low-sensitivity content (not journal data). v2 rules do not cascade the
      // parent allow, so this subcollection needs its own rule.
      match /quizAttempts/{attemptId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Journal entries: top-level collection keyed by a userId field.
    match /journals/{journalId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Public marketing waitlist (landing page). Anyone may add their email
    // (the doc id is the lowercased email, so re-submits upsert idempotently),
    // but the list is never publicly readable or deletable — it holds PII.
    match /waitlist/{email} {
      allow read, delete: if false;
      allow create, update: if request.resource.data.email is string
        && request.resource.data.email == email
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 320
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$');
    }

    // Public essay-contest submissions (MYBW 2026 landing page). Anyone may create
    // an entry (auto id), but the collection is never publicly readable/updatable/
    // deletable — it holds PII. Field constraints mirror the client-side validator.
    match /contestSubmissions/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
        && request.resource.data.company is string
        && request.resource.data.company.size() > 0
        && request.resource.data.company.size() < 200
        && request.resource.data.role is string
        && request.resource.data.role.size() > 0
        && request.resource.data.role.size() < 200
        && request.resource.data.xAccount is string
        && request.resource.data.xAccount.size() > 0
        && request.resource.data.xAccount.size() < 200
        && request.resource.data.essayUrl is string
        && request.resource.data.essayUrl.matches('^https?://.*')
        && request.resource.data.essayUrl.size() < 2000
        && request.resource.data.ethAddress is string
        && request.resource.data.ethAddress.matches('^0x[0-9a-fA-F]{40}$')
        && request.resource.data.agreedToTerms == true;
    }

    // Chats: top-level collection keyed by a userId field.
    match /chats/{chatId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      // Messages subcollection: inherit ownership from the parent chat.
      match /messages/{messageId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
      }
    }

    // Daily reports: indexed by user (uid) and date. Zero-knowledge — the client
    // generates the card server-side but re-encrypts and PERSISTS it itself (the
    // server holds no DEK and no longer writes here; see ADR-0073 + e11b871), so
    // the owner needs full read/write of their own reports. The doc-path `uid`
    // segment is the ownership key; no `userId` field to check (unlike journals).
    match /dailyReports/{uid}/days/{date} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
