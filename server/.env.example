PORT=3200
NODE_ENV=development
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
CHROMA_URL=http://localhost:8000
TOGETHER_AI_API_KEY=
TOGETHER_EMBEDDING_MODEL=togethercomputer/m2-bert-80M-8k-retrieval
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_SECRET=
# RevenueCat REST v1 secret key. Optional: lets `requirePro` self-heal a missed
# webhook by asking RevenueCat directly before returning 402. Unset = the guard
# degrades to Firestore-only rather than to an outage.
REVENUECAT_REST_API_KEY=
# 32-byte base64 master key that wraps each user's data key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=
# Optional — Hume Expression Measurement (entry emotion scoring). Unset = scoring skipped.
HUME_API_KEY=
# Optional — Unsplash Search (shareable card background). Unset = gradient fallback.
UNSPLASH_ACCESS_KEY=


# Soul Constellation NFT (Base). All optional in config.ts — placeholders only here.
# CDP (Coinbase Developer Platform) Server Wallet — backend-custodied user wallets.
#   ID/SECRET: portal.cdp.coinbase.com → API Keys → Create secret API key
#   WALLET_SECRET: portal → Wallets → Non-custodial Wallet → Security → Generate Wallet Secret
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# Base chain: minter EOA (deploys/owns the contract), RPC, deployed contract address.
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN=base-sepolia   # set to 'base' for mainnet (with mainnet contract/RPC/minter)
BASE_MINTER_PRIVATE_KEY=
SOULBOUND_CONTRACT_ADDRESS=
# Public base for tokenURI; must match the contract's baseURI.
NFT_METADATA_BASE_URL=https://api.luminalog.com/v1/nft/
# Enforce AI-data-sharing consent (5.1.1/5.1.2): 403 on AI routes without a
# recorded users/{uid}.consent.aiDataSharing===true. ON now that the iOS consent
# screen + gate ship (feat/ai-consent-screen).
ENFORCE_AI_CONSENT=true
# Enforce the Pro paywall: 402 on the AI/RAG consumption routes without an active
# `pro` entitlement. Ships OFF (unset) and stays off until the would-have-blocked
# rate is confirmed near zero for shipped iOS clients, which hit these same routes.
# ENFORCE_PRO=true
# Deepgram — voice/video journal-entry transcription (nova-3). Optional: if unset,
# entry transcription falls back to Together Whisper. Text dictation stays on-device.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- Server LLM provider switch (ADR-0085/0087/0138/0139) ---
# `venice` (default as of ADR-0139) routes chat/summary/entry-AI/daily-report to
# Venice AI; `morpheus` routes them to the Morpheus decentralized TEE marketplace;
# `together` uses the legacy provider. NO cross-provider fallback: a failed call is
# retried against the same provider. STT (Whisper/Deepgram) follows AI_PROVIDER too
# as of ADR-0138: venice uses Venice's own Whisper endpoint, morpheus/together still
# use Together (Morpheus has no STT of its own).
AI_PROVIDER=venice
# Legacy Together chat model (only used when AI_PROVIDER=together).
TOGETHER_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# Morpheus gateway credentials + the ONE global chat model. Swap MORPHEUS_CHAT_MODEL
# to change the model app-wide. MUST be a routable lowercase-hyphen SLUG: Morpheus
# 503s ("capacity reserved for priority models") on most ids incl. every Claude/
# Llama/Gemma slug and all display-name ids ("GLM 5.2"). `deepseek-v4-flash` is
# open-weights, reliably 200, cheap/fast, and returns clean JSON. NEVER use a
# reasoning model like `deepseek-v4-pro` (empty `content`).
MORPHEUS_API_KEY=
MORPHEUS_BASE_URL=https://api.mor.org/api/v1
MORPHEUS_CHAT_MODEL=deepseek-v4-flash
# Ordered, comma-separated FALLBACK slugs tried after MORPHEUS_CHAT_MODEL exhausts
# its retries on a 503/transient. Keeps entry-AI generation working during per-model
# Morpheus outages, WITHOUT leaving the private gateway (no cross-provider fallback).
# Routable open-weights slugs only; never a reasoning model. Default: glm-5.2.
MORPHEUS_CHAT_MODEL_FALLBACKS=glm-5.2
# ── Live-VOICE-only model routing (Vapi custom-LLM proxy, ADR-0109/0138) ──────
# Voice has a HARD deadline: Vapi kills the call as `custom-llm-llm-failed` when a
# turn is too slow, so it gets its own provider switch, independent of AI_PROVIDER.
# Defaults to `venice` as of ADR-0138 (product decision, no live-turn latency probe
# yet). Revert instantly with VOICE_AI_PROVIDER=together if it proves too slow.
# Prior measured streaming TTFB (before the Venice default), 10 runs:
#   together meta-llama/Llama-3.3-70B-Instruct-Turbo → ~0.95s median, 2.06s max
#   morpheus glm-5.2 / deepseek-v4-flash             → ~1.6-2.5s median, 5-10s max
# Both vars are OPTIONAL. Omit them and voice runs on Venice automatically.
# VOICE_AI_PROVIDER=venice
# Overrides the model for whichever provider VOICE_AI_PROVIDER selects. Flip both
# to move voice back to Morpheus once it can serve a fast slug again. Must be a
# routable SLUG (display names like "Gemini 3.5 Flash" 503) and NOT a reasoning
# model like deepseek-v4-pro (its text lands in reasoning_content → empty reply).
# VOICE_CHAT_MODEL=
MORPHEUS_EMBEDDING_MODEL=text-embedding-bge-m3
# Venice AI (ADR-0138). Cheapest current Gemini Flash tier on Venice, "Anonymized"
# privacy tier (encrypted in transit, no prompt retention, not hardware-isolated).
VENICE_AI_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_CHAT_MODEL=gemini-3-5-flash-lite
VENICE_STT_MODEL=openai/whisper-large-v3
# Venice embedding model (ADR-0139). Same open-weights BGE-M3 model Morpheus uses:
# live-probed 2026-08-30, Venice and Morpheus vectors were cosine 1.0 (bit-identical),
# so swapping providers does not break the 1024-dim production Chroma index.
VENICE_EMBEDDING_MODEL=text-embedding-bge-m3
# PostHog product analytics. BOTH optional: unset means the /v1/ph proxy drops
# events and the RevenueCat forwarder no-ops, and the server boots normally.
# POSTHOG_API_HOST is PostHog's OWN ingestion host (the upstream), not the
# api.luminalog.com/v1/ph address the iOS app points at.
POSTHOG_API_HOST=
POSTHOG_PROJECT_API_KEY=
